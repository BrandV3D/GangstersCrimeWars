<Window x:Class="Gangster_Crime_Wars"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GangstersCrimeWars"
        mc:Ignorable="d"
        Title="Gangster Crime Wars" Height="1000" Width="1400"
        Background="#0B0B0D"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <SolidColorBrush x:Key="GoldBrush" Color="#C9A227"/>
        <SolidColorBrush x:Key="CreamBrush" Color="#EFE6D0"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#17151A"/>
        <FontFamily x:Key="TitleFont">pack://siteoforigin:,,,/Assets/Fonts/#Bootleggers</FontFamily>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#17151A"/>
            <Setter Property="Foreground" Value="{StaticResource GoldBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource GoldBrush}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Margin" Value="6,0"/>
            <Setter Property="FontFamily" Value="Georgia"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource GoldBrush}"/>
            <Setter Property="FontFamily" Value="Georgia"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="2,10,0,2"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="300"/>
        </Grid.ColumnDefinitions>

        <!-- Table background texture, dimmed so panels stay legible -->
        <Image x:Name="TableBackgroundImage" Grid.ColumnSpan="2" Stretch="UniformToFill" Opacity="0.16"/>

        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="12">

                <!-- Banner -->
                <StackPanel HorizontalAlignment="Center" Margin="0,4,0,4">
                    <Image x:Name="BannerImage" MaxHeight="90" Stretch="Uniform"/>
                    <TextBlock Text="GANGSTER CRIME WARS" FontFamily="{StaticResource TitleFont}" FontSize="34" FontWeight="Bold"
                               Foreground="{StaticResource GoldBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="1920s Organized Crime — Inventory &amp; Turf Strategy" FontFamily="Georgia" FontSize="12" FontStyle="Italic"
                               Foreground="{StaticResource CreamBrush}" HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Rival Boss -->
                <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource GoldBrush}" BorderThickness="1" Margin="0,10,0,6" Padding="10,6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="40" Height="40" CornerRadius="20" ClipToBounds="True" Margin="0,0,8,0">
                            <Image x:Name="RivalArtImage" Stretch="UniformToFill"/>
                        </Border>
                        <Image x:Name="RivalPortraitImage" Grid.Column="1" Height="26" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                            <TextBlock Text="AP " Foreground="{StaticResource CreamBrush}" FontFamily="Georgia" FontSize="11" VerticalAlignment="Center"/>
                            <StackPanel x:Name="RivalApPanel" Orientation="Horizontal" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Grid x:Name="RivalLifeBarTrack" Grid.Column="4" Width="150" Height="20" Margin="0,0,12,0">
                            <Border Background="#331010" CornerRadius="2"/>
                            <Rectangle x:Name="RivalLifeBarFill" Height="20" HorizontalAlignment="Left" Width="150">
                                <Rectangle.Fill>
                                    <ImageBrush x:Name="RivalLifeBarBrush" Stretch="Fill"/>
                                </Rectangle.Fill>
                            </Rectangle>
                            <TextBlock x:Name="RivalLifeText" Foreground="White" FontFamily="Georgia" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center">
                            <Image x:Name="RivalCashIcon" Width="18" Height="18" Margin="0,0,4,0"/>
                            <TextBlock x:Name="RivalCashText" Foreground="{StaticResource GoldBrush}" FontFamily="Georgia" FontWeight="Bold" FontSize="16" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Height="195" Background="#101014" BorderBrush="#333333" BorderThickness="1">
                    <WrapPanel x:Name="RivalBoardPanel" Margin="6"/>
                </Border>

                <!-- Middle action bar -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10">
                    <Button x:Name="AttackBossButton" Content="ATTACK BOSS" Style="{StaticResource ActionButtonStyle}" Click="AttackBossButton_Click" IsEnabled="False"/>
                    <Button x:Name="EndTurnButton" Content="END TURN" Style="{StaticResource ActionButtonStyle}" Click="EndTurnButton_Click"/>
                    <Button x:Name="NewGameButton" Content="NEW WAR" Style="{StaticResource ActionButtonStyle}" Click="NewGameButton_Click"/>
                    <Button x:Name="HowToPlayButton" Content="HOW TO PLAY" Style="{StaticResource ActionButtonStyle}" Click="HowToPlayButton_Click"/>
                    <Button x:Name="MuteButton" Content="🔊" Style="{StaticResource ActionButtonStyle}" Click="MuteButton_Click"/>
                    <TextBlock x:Name="TurnText" Foreground="{StaticResource CreamBrush}" FontFamily="Georgia" FontSize="14" VerticalAlignment="Center" Margin="16,0,0,0"/>
                </StackPanel>

                <Border Height="195" Background="#101014" BorderBrush="#333333" BorderThickness="1">
                    <WrapPanel x:Name="OwnBoardPanel" Margin="6"/>
                </Border>

                <!-- Own Boss -->
                <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource GoldBrush}" BorderThickness="1" Margin="0,6,0,6" Padding="10,6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="40" Height="40" CornerRadius="20" ClipToBounds="True" Margin="0,0,8,0">
                            <Image x:Name="OwnArtImage" Stretch="UniformToFill"/>
                        </Border>
                        <Image x:Name="OwnPortraitImage" Grid.Column="1" Height="26" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                            <TextBlock Text="AP " Foreground="{StaticResource CreamBrush}" FontFamily="Georgia" FontSize="11" VerticalAlignment="Center"/>
                            <StackPanel x:Name="OwnApPanel" Orientation="Horizontal" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Grid x:Name="OwnLifeBarTrack" Grid.Column="4" Width="150" Height="20" Margin="0,0,12,0">
                            <Border Background="#331010" CornerRadius="2"/>
                            <Rectangle x:Name="OwnLifeBarFill" Height="20" HorizontalAlignment="Left" Width="150">
                                <Rectangle.Fill>
                                    <ImageBrush x:Name="OwnLifeBarBrush" Stretch="Fill"/>
                                </Rectangle.Fill>
                            </Rectangle>
                            <TextBlock x:Name="OwnLifeText" Foreground="White" FontFamily="Georgia" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center">
                            <Image x:Name="OwnCashIcon" Width="18" Height="18" Margin="0,0,4,0"/>
                            <TextBlock x:Name="OwnCashText" Foreground="{StaticResource GoldBrush}" FontFamily="Georgia" FontWeight="Bold" FontSize="16" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Turf / territory -->
                <Image x:Name="MapBannerImage" MaxHeight="70" Stretch="Uniform" Margin="0,8,0,2"/>
                <TextBlock Text="RIVAL TURF" Style="{StaticResource SectionHeaderStyle}"/>
                <Border Height="150" Background="#101014" BorderBrush="#333333" BorderThickness="1">
                    <WrapPanel x:Name="RivalTurfPanel" Margin="6"/>
                </Border>
                <TextBlock Text="YOUR TURF" Style="{StaticResource SectionHeaderStyle}"/>
                <Border Height="150" Background="#101014" BorderBrush="{StaticResource GoldBrush}" BorderThickness="1">
                    <WrapPanel x:Name="OwnTurfPanel" Margin="6"/>
                </Border>

                <!-- Markets -->
                <Image x:Name="RecruitHeaderImage" MaxHeight="30" Stretch="Uniform" HorizontalAlignment="Left" Margin="2,14,0,4"/>
                <Border Height="150" Background="#101014" BorderBrush="#333333" BorderThickness="1">
                    <WrapPanel x:Name="CrewMarketPanel" Margin="6"/>
                </Border>

                <Image x:Name="BootleggingHeaderImage" MaxHeight="30" Stretch="Uniform" HorizontalAlignment="Left" Margin="2,10,0,4"/>
                <Border Height="150" Background="#101014" BorderBrush="#333333" BorderThickness="1">
                    <WrapPanel x:Name="WeaponMarketPanel" Margin="6"/>
                </Border>

                <Image x:Name="CityBuildingsHeaderImage" MaxHeight="30" Stretch="Uniform" HorizontalAlignment="Left" Margin="2,10,0,4"/>
                <Border Height="150" Background="#101014" BorderBrush="#333333" BorderThickness="1">
                    <WrapPanel x:Name="BuildingMarketPanel" Margin="6"/>
                </Border>

                <!-- Inventory -->
                <TextBlock Text="INVENTORY — click a weapon, then click your crew to arm them" Style="{StaticResource SectionHeaderStyle}"/>
                <Border Height="150" Background="#101014" BorderBrush="{StaticResource GoldBrush}" BorderThickness="1">
                    <WrapPanel x:Name="InventoryPanel" Margin="6"/>
                </Border>

                <!-- Jobs -->
                <TextBlock Text="JOBS" Style="{StaticResource SectionHeaderStyle}"/>
                <Border Height="195" Background="#101014" BorderBrush="{StaticResource GoldBrush}" BorderThickness="1">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="JobHandPanel" Orientation="Horizontal" Margin="8"/>
                    </ScrollViewer>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <Border Grid.Column="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource GoldBrush}" BorderThickness="1,0,0,0" Margin="0,12,12,12">
            <Grid>
                <Image x:Name="NewspaperImage" Stretch="UniformToFill" Opacity="0.14"/>
                <DockPanel>
                    <Image x:Name="NewspaperHeaderImage" DockPanel.Dock="Top" MaxHeight="26" Stretch="Uniform" HorizontalAlignment="Left" Margin="10,10,10,4"/>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,10">
                        <Image x:Name="OwnDeckBackImage" Width="34" Height="46" Margin="4,0"/>
                        <TextBlock x:Name="OwnDeckCountText" Foreground="{StaticResource CreamBrush}" FontFamily="Georgia" FontSize="11" VerticalAlignment="Center" Margin="2,0,10,0"/>
                        <Image x:Name="RivalDeckBackImage" Width="34" Height="46" Margin="4,0"/>
                        <TextBlock x:Name="RivalDeckCountText" Foreground="{StaticResource CreamBrush}" FontFamily="Georgia" FontSize="11" VerticalAlignment="Center" Margin="2,0"/>
                    </StackPanel>
                    <ListBox x:Name="LogListBox" Background="Transparent" BorderThickness="0" Foreground="{StaticResource CreamBrush}" FontFamily="Consolas" FontSize="11"/>
                </DockPanel>
            </Grid>
        </Border>

        <MediaElement x:Name="MusicPlayer" LoadedBehavior="Manual" Visibility="Collapsed"/>
    </Grid>
</Window>
